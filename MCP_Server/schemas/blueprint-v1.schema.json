{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CanArslanDev/ableton-live-mcp/blob/main/MCP_Server/schemas/blueprint-v1.schema.json",
  "title": "ableton-live-mcp blueprint, version 1",
  "description": "Everything build_from_blueprint needs to build a beat in an empty Live set, decided without Live. See docs/blueprint-v1.md.",
  "type": "object",
  "required": ["format", "version", "tempo", "time_signature", "tracks"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "ableton-mcp-blueprint"},
    "version": {"const": 1},
    "name": {"type": "string", "description": "What is built (the song's name), for the report."},
    "made_by": {"type": "string", "description": "What wrote the blueprint, e.g. \"refdissect 0970a03\"."},
    "meta": {"type": "object", "description": "Free-form notes; the build ignores them."},
    "tempo": {"type": "number", "minimum": 20, "maximum": 999},
    "time_signature": {"type": "string", "pattern": "^[1-9][0-9]?/(1|2|4|8|16)$"},
    "length_beats": {"type": "number", "exclusiveMinimum": 0,
                     "description": "The song's length; bars= cuts excerpts within it."},
    "locators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "beat"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "beat": {"type": "number", "minimum": 0}
        }
      }
    },
    "files": {
      "type": "object",
      "description": "Files the build copies into <User Library>/Samples/AbletonMCP Generated/, by a key the samplers name.",
      "propertyNames": {"pattern": "^[A-Za-z0-9_.:-]{1,64}$"},
      "additionalProperties": {"$ref": "#/$defs/file"}
    },
    "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/track"}},
    "checks": {
      "type": "object",
      "description": "Read-backs after the build; each is on unless set to false.",
      "additionalProperties": false,
      "properties": {
        "time_signature": {"type": "boolean"},
        "samples": {"type": "boolean"},
        "volumes": {"type": "boolean"},
        "choke_groups": {"type": "boolean"},
        "locators": {"type": "boolean"},
        "voices": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["source", "name"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1,
                   "description": "The file: absolute, or relative to the blueprint's folder."},
        "name": {"type": "string", "pattern": "^[^/\\\\]+\\.(wav|WAV|aif|AIF|aiff|AIFF|flac|FLAC|mp3|MP3|ogg|OGG)$",
                 "description": "Its name in the User Library; name it after its content (Live keeps playing what it loaded under a name)."},
        "gain_db": {"type": "number", "maximum": 0, "minimum": -120,
                    "description": "Under 0: the copy is the file scaled by this, as a 32-bit float WAV."},
        "sha1": {"type": "string", "pattern": "^[0-9a-f]{8,40}$",
                 "description": "The start of the source's SHA-1: the build refuses a source that changed."}
      }
    },
    "settings": {
      "type": "object",
      "description": "Device parameters by name: numbers set the raw value, text goes by Live's display (\"-6.0 dB\").",
      "additionalProperties": {"type": ["number", "string"]}
    },
    "sampler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "description": "A key of files: the Simpler must hold that file's copy."},
        "sample_path": {"type": "string", "description": "An absolute file loaded as it is (not copied)."},
        "sample": {"type": "string", "description": "A browser name, when there is no file."},
        "warping": {"type": "boolean"},
        "playback_mode": {"enum": ["classic", "one_shot", "slicing", 0, 1, 2]},
        "start_marker": {"type": "integer", "minimum": 0},
        "settings": {"$ref": "#/$defs/settings"},
        "choke_group": {"type": "integer", "minimum": 0, "maximum": 16}
      }
    },
    "drum_rack": {
      "type": "object",
      "required": ["drum_rack"],
      "additionalProperties": false,
      "properties": {
        "drum_rack": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^([0-9]|[1-9][0-9]|1[01][0-9]|12[0-7])$"},
          "additionalProperties": {"$ref": "#/$defs/sampler"}
        }
      }
    },
    "note": {
      "type": "object",
      "required": ["pitch", "start_time", "duration"],
      "additionalProperties": false,
      "properties": {
        "pitch": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 127},
                            {"type": "string", "minLength": 2}]},
        "start_time": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "velocity": {"type": "number", "minimum": 0, "maximum": 127},
        "mute": {"type": "boolean"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1},
        "velocity_deviation": {"type": "number", "minimum": -127, "maximum": 127},
        "release_velocity": {"type": "number", "minimum": 0, "maximum": 127}
      }
    },
    "clip": {
      "type": "object",
      "required": ["start", "length"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "length": {"type": "number", "exclusiveMinimum": 0},
        "name": {"type": "string"},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}}
      }
    },
    "audio_clip": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "minLength": 1,
                 "description": "Absolute, or relative to the blueprint's folder; played from its start."},
        "start": {"type": "number", "minimum": 0},
        "warping": {"type": "boolean"}
      }
    },
    "effect": {
      "type": "object",
      "required": ["device"],
      "additionalProperties": false,
      "properties": {
        "device": {"type": "string", "minLength": 1},
        "settings": {"$ref": "#/$defs/settings"},
        "sidechain_from": {"type": "string"}
      }
    },
    "track": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["midi", "audio"]},
        "instrument": {"oneOf": [{"type": "string", "minLength": 1},
                                 {"$ref": "#/$defs/drum_rack"},
                                 {"$ref": "#/$defs/sampler"}]},
        "settings": {"$ref": "#/$defs/settings"},
        "voices": {"type": "integer", "minimum": 1, "maximum": 32,
                   "description": "A Simpler's voices (a device property), set after the build: 1 with Glide Mode \"Glide\" slides overlapping notes."},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "volume_db": {"type": "number", "maximum": 6},
        "pan": {"type": "number", "minimum": -1, "maximum": 1},
        "mute": {"type": "boolean"},
        "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}},
        "audio_clips": {"type": "array", "items": {"$ref": "#/$defs/audio_clip"}}
      }
    }
  }
}
